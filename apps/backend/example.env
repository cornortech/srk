# ============================================
# SRK University Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env file to version control

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# MongoDB connection string
# Format: mongodb://localhost:27017/database_name
# Or Atlas: mongodb+srv://username:password@cluster.mongodb.net/database_name
DATABASE_URL=

# --------------------------------------------
# Email Configuration (SMTP)
# --------------------------------------------
# Email address used to send system emails (registration, notifications, etc.)
APP_EMAIL=

# SMTP password for the email account
# For Gmail: Use App Password (not your regular password)
# Enable 2FA and generate app password at: https://myaccount.google.com/apppasswords
SMTP_PW=

# --------------------------------------------
# Application URLs
# --------------------------------------------
# Frontend application base URL (for email links and redirects)
# Development: http://localhost:4200
# Production: https://yourdomain.com
FRONTEND_BASE_URL=

# --------------------------------------------
# Security Configuration
# --------------------------------------------
# Secret key for JWT token encryption
# Generate a random 64-character string: openssl rand -hex 32
JWT_SECRET=

# Comma-separated list of allowed CORS origins
# Add your frontend URLs here to allow API access
WHITE_LISTED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5000,http://localhost:5173,http://localhost:5174,http://localhost:4200

# --------------------------------------------
# Firebase Admin SDK Configuration
# --------------------------------------------
# Firebase project ID from Firebase Console
# Get from: Firebase Console > Project Settings > General
FIREBASE_PROJECT_ID=

# Firebase service account client email
# Get from: Firebase Console > Project Settings > Service Accounts
# Download the service account JSON file and copy these values
FIREBASE_CLIENT_EMAIL=

# Firebase service account private key
# IMPORTANT: Keep the \n characters in the key for proper formatting
# Format: -----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvg