# ============================================
# SRK University Frontend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env file to version control

# --------------------------------------------
# Package Configuration
# --------------------------------------------
# The MongoDB ObjectId of the PRO package from your packages collection
# This is used to identify and display PRO package features in the UI
VITE_PRO_PACKAGE_ID=

# --------------------------------------------
# Firebase Configuration
# --------------------------------------------
# Your Firebase project API key for authentication and services
# Get this from: Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=

# --------------------------------------------
# Application URLs
# --------------------------------------------
# The base URL of your frontend application
# Development: http://localhost:4200
# Production: https://yourdomain.com
VITE_FRONTEND_ROOT_URL=

# The base URL of your backend API server
# Development: http://localhost:3000
# Production: https://api.yourdomain.com
VITE_BACKEND_ROOT_URL=
VITE_IS_PROD=false
IS_PROD=false