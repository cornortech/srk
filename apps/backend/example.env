# ============================================
# SRK Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit .env to version control.

# --------------------------------------------
# Runtime / Environment
# --------------------------------------------
NODE_ENV=development
PORT=4000

# Controls R2 upload namespace:
# true  -> srk/
# false -> dev/
IS_PROD=false

# --------------------------------------------
# Database Configuration
# --------------------------------------------
DATABASE_URL=

# --------------------------------------------
# URLs and Auth
# --------------------------------------------
FRONTEND_BASE_URL=http://localhost:4200
TASK_FRONTEND_URL=http://localhost:4400
GROW_FRONTEND_URL=http://localhost:4500
BANK_FRONTEND_URL=http://localhost:4300

# Optional cookie domain for cross-subdomain auth in production.
COOKIE_DOMAIN=

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated list of allowed CORS origins
WHITE_LISTED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:4300,http://localhost:4400,http://localhost:4500,http://localhost:5000,http://localhost:5173,http://localhost:5174,http://localhost:4200

# --------------------------------------------
# Email Configuration (SMTP)
# --------------------------------------------
APP_EMAIL=
SMTP_PW=

# --------------------------------------------
# Cloudflare R2 Configuration
# --------------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=srk
CDN_BASE_URL=https://cdn.thesrkuniversity.com

# --------------------------------------------
# Note
# --------------------------------------------
# This backend currently uses Cloudflare R2 for file storage.
# Cloudinary and Firebase env keys are intentionally omitted.
