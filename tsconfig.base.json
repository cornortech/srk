{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@srk/shared/ui": ["libs/shared/ui/src/index.ts"],
      "@srk/shared/ui-components": ["libs/shared/ui-components/src/index.ts"],
      "@srk/shared/hooks": ["libs/shared/hooks/src/index.ts"],
      "@srk/shared/utils": ["libs/shared/utils/src/index.ts"],
      "@srk/shared/store": ["libs/shared/store/src/index.ts"],
      "@srk/shared/api": ["libs/shared/api/src/index.ts"],
      "@srk/shared/types": ["libs/shared/types/src/index.ts"],
      "@srk/shared/assets": ["libs/shared/assets/src/index.ts"],
      "@srk/task": ["apps/task/src/index.ts"],
      "@srk/task/*": ["apps/task/src/*"],
      "@srk/shared/contracts": ["libs/shared/contracts/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
